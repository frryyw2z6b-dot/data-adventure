[
 {
  "key": "a9ba9a99",
  "text": "أَحْسَنْتِ يَا بَطَلَةُ!"
 },
 {
  "key": "779f7155",
  "text": "رَائِعٌ جِدًّا!"
 },
 {
  "key": "5139f302",
  "text": "مُمْتَازٌ يَا مُسْتَكْشِفَةُ!"
 },
 {
  "key": "a44c5bcf",
  "text": "عَمَلٌ جَمِيلٌ جِدًّا!"
 },
 {
  "key": "bebfb2be",
  "text": "إِجَابَةٌ صَحِيحَةٌ، أَحْسَنْتِ!"
 },
 {
  "key": "069b455e",
  "text": "حَاوِلِي مَرَّةً أُخْرَى."
 },
 {
  "key": "4c7a87db",
  "text": "فَكِّرِي قَلِيلًا وَجَرِّبِي."
 },
 {
  "key": "0d15f005",
  "text": "قَرِيبَةٌ! جَرِّبِي مُجَدَّدًا."
 },
 {
  "key": "33801726",
  "text": "عُدِّي مَرَّةً أُخْرَى بِهُدُوءٍ."
 },
 {
  "key": "3369379b",
  "text": "اُنْظُرِي، هَذَا مَكَانُهَا الصَّحِيحُ."
 },
 {
  "key": "052a136d",
  "text": "اُنْظُرِي إِلَى الْإِجَابَةِ الصَّحِيحَةِ."
 },
 {
  "key": "26d50de0",
  "text": "أَحْسَنْتِ! أَنْهَيْتِ هَذِهِ الْمَرْحَلَةَ."
 },
 {
  "key": "ef0c6ff9",
  "text": "مَبْرُوكٌ! أَنْهَيْتِ الْمُغَامَرَةَ كُلَّهَا. أَنْتِ مُسْتَكْشِفَةُ بَيَانَاتٍ حَقِيقِيَّةٌ!"
 },
 {
  "key": "0e0bde8d",
  "text": "أَهْلًا بِكِ! أَنَا نُورَةُ، رَفِيقَتُكِ فِي الْمُغَامَرَةِ."
 },
 {
  "key": "cbb56101",
  "text": "اُكْتُبِي رَمْزَ الْفَصْلِ مِنْ مُعَلِّمَتِكِ."
 },
 {
  "key": "437cf5e3",
  "text": "اِبْحَثِي عَنِ اسْمِكِ وَالْمِسِيهِ."
 },
 {
  "key": "d55a96ba",
  "text": "هُنَا تَكْتُبِينَ اسْمَكِ."
 },
 {
  "key": "21f92ce9",
  "text": "اِخْتَارِي الْمَرْحَلَةَ الْمُضِيئَةَ."
 },
 {
  "key": "eae61b01",
  "text": "هَلْ تَسْمَعِينَنِي؟ رَائِعٌ! الصَّوْتُ يَعْمَلُ."
 },
 {
  "key": "7c7453e2",
  "text": "هَلْ تُرِيدِينَ الْعَوْدَةَ إِلَى الْخَرِيطَةِ؟"
 },
 {
  "key": "f94febaa",
  "text": "كُلُّ لَمْسَةٍ تَرْسُمُ إِشَارَةً، وَالْخَامِسَةُ تَقْطَعُ الْأَرْبَعَ."
 },
 {
  "key": "9b31bb5b",
  "text": "اِلْمِسِي الصَّفَّ لِتُضِيفِي صُورَةً، وَالْمِسِي الصُّورَةَ لِتَحْذِفِيهَا."
 },
 {
  "key": "bd3e7cde",
  "text": "اِلْمِسِي الْمُرَبَّعَ عِنْدَ الْعَدَدِ الْمَطْلُوبِ."
 },
 {
  "key": "dd675742",
  "text": "اَلْمَرْحَلَةُ الْأُولَى: الْفَرْزُ وَالتَّصْنِيفُ."
 },
 {
  "key": "a81fff39",
  "text": "اَلْمَرْحَلَةُ الثَّانِيَةُ: جَدَاوِلُ الْإِشَارَاتِ."
 },
 {
  "key": "1dd254de",
  "text": "اَلْمَرْحَلَةُ الثَّالِثَةُ: التَّمْثِيلُ بِالصُّوَرِ."
 },
 {
  "key": "08dfc2d4",
  "text": "اَلْمَرْحَلَةُ الرَّابِعَةُ: الْأَعْمِدَةُ الْبَيَانِيَّةُ."
 },
 {
  "key": "eb232ba5",
  "text": "اَلْمَرْحَلَةُ الْخَامِسَةُ: قِرَاءَةُ الْبَيَانَاتِ."
 },
 {
  "key": "7624f582",
  "text": "أَهْلًا بِكِ فِي وَاحَةِ النَّخِيلِ! أَنَا نُورَةُ. هَيَّا نَفْرِزُ الْأَشْيَاءَ فِي السِّلَالِ."
 },
 {
  "key": "96e2a20c",
  "text": "ضَعِي كُلَّ كُرَةٍ فِي سَلَّةِ لَوْنِهَا."
 },
 {
  "key": "5fc46367",
  "text": "اِفْرِزِي حَسَبَ الشَّكْلِ: الْكُرَاتُ مَعًا، وَالْمُكَعَّبَاتُ مَعًا."
 },
 {
  "key": "f0e5122c",
  "text": "ضَعِي الْفَاكِهَةَ فِي سَلَّةٍ، وَأَدَوَاتِ الْقَهْوَةِ فِي سَلَّةٍ."
 },
 {
  "key": "28b55304",
  "text": "اِفْرِزِي الْأَشْيَاءَ حَسَبَ اللَّوْنِ."
 },
 {
  "key": "c87f2b26",
  "text": "أَيُّ شَيْءٍ شَكْلُهُ مُخْتَلِفٌ؟ اِلْمِسِيهِ."
 },
 {
  "key": "9a9e680c",
  "text": "كَيْفَ فُرِزَتْ هَذِهِ الْأَشْيَاءُ؟"
 },
 {
  "key": "70dc0bf1",
  "text": "حَسَبَ اللَّوْنِ"
 },
 {
  "key": "7e465f84",
  "text": "حَسَبَ الشَّكْلِ"
 },
 {
  "key": "a0f903b6",
  "text": "حَسَبَ الْحَجْمِ"
 },
 {
  "key": "db7ddd8a",
  "text": "فِي سُوقِ الْقَرْيَةِ نَعُدُّ بِالْإِشَارَاتِ. كُلُّ خَمْسِ إِشَارَاتٍ تَصِيرُ حُزْمَةً."
 },
 {
  "key": "981bd61c",
  "text": "كَمْ إِشَارَةً عَلَى اللَّوْحِ؟"
 },
 {
  "key": "5bf311e2",
  "text": "هَذِهِ حُزْمَةٌ. كَمْ إِشَارَةً فِيهَا؟"
 },
 {
  "key": "be27b643",
  "text": "عُدِّي التَّمْرَ، ثُمَّ ارْسُمِي إِشَارَاتِهِ."
 },
 {
  "key": "baf9cecd",
  "text": "عُدِّي الْفَنَاجِينَ، ثُمَّ ارْسُمِي إِشَارَاتِهَا."
 },
 {
  "key": "abb3a99a",
  "text": "أَيُّ فَاكِهَةٍ عَدَدُهَا أَكْثَرُ؟"
 },
 {
  "key": "290620b1",
  "text": "كَمْ بُرْتُقَالَةً فِي الْجَدْوَلِ؟"
 },
 {
  "key": "4baee663",
  "text": "فِي قَلْعَةِ الْحِصْنِ نُمَثِّلُ الْبَيَانَاتِ بِالصُّوَرِ. كُلُّ صُورَةٍ تَعْنِي وَاحِدًا."
 },
 {
  "key": "08b63257",
  "text": "كَمْ طَالِبَةً تُحِبُّ التُّفَّاحَ؟"
 },
 {
  "key": "c2e3c5e7",
  "text": "أَيُّ فَاكِهَةٍ تُحِبُّهَا طَالِبَاتٌ أَكْثَرُ؟"
 },
 {
  "key": "27ad106f",
  "text": "أَيُّ فَاكِهَةٍ تُحِبُّهَا طَالِبَاتٌ أَقَلُّ؟"
 },
 {
  "key": "3f05122e",
  "text": "اِلْمِسِي كُلَّ صَفٍّ لِتُضِيفِي صُوَرًا مِثْلَ الْجَدْوَلِ."
 },
 {
  "key": "615b1e03",
  "text": "اِصْنَعِي صُوَرًا مِثْلَ الْجَدْوَلِ."
 },
 {
  "key": "ff0e4291",
  "text": "كَمْ كُرَةً زَرْقَاءَ هُنَا؟"
 },
 {
  "key": "ff9df9e3",
  "text": "مِنْ بُرْجِ الْمُرَاقَبَةِ نَقْرَأُ الْأَعْمِدَةَ الْبَيَانِيَّةَ. اُنْظُرِي إِلَى طُولِ كُلِّ عَمُودٍ."
 },
 {
  "key": "2a84b318",
  "text": "كَمْ تَمْرَةً فِي السَّلَّةِ؟"
 },
 {
  "key": "5315afba",
  "text": "أَيُّ عَمُودٍ هُوَ الْأَطْوَلُ؟"
 },
 {
  "key": "03ffab7d",
  "text": "أَيُّ عَمُودٍ هُوَ الْأَقْصَرُ؟"
 },
 {
  "key": "693984d1",
  "text": "اِلْمِسِي كُلَّ عَمُودٍ عِنْدَ الْعَدَدِ الصَّحِيحِ."
 },
 {
  "key": "1a9477b8",
  "text": "اِرْسُمِي الْأَعْمِدَةَ مِثْلَ الْجَدْوَلِ."
 },
 {
  "key": "b7ca4a0f",
  "text": "أَيُّ لَوْنٍ عَدَدُهُ خَمْسَةٌ؟"
 },
 {
  "key": "46d332d4",
  "text": "فِي خَيْمَةِ الْحُكَمَاءِ نُقَارِنُ وَنَسْتَنْتِجُ. فَكِّرِي جَيِّدًا!"
 },
 {
  "key": "4307bd58",
  "text": "كَمْ يَزِيدُ التَّمْرُ عَلَى الْبُرْتُقَالِ؟"
 },
 {
  "key": "638c6d3c",
  "text": "كَمْ مَجْمُوعُ التَّمْرِ وَالتُّفَّاحِ؟"
 },
 {
  "key": "1822c60a",
  "text": "أَيُّ شَكْلَيْنِ لَهُمَا الْعَدَدُ نَفْسُهُ؟"
 },
 {
  "key": "50334c3a",
  "text": "اَلْكُرَةُ وَالْمُكَعَّبُ"
 },
 {
  "key": "1c9e9cfa",
  "text": "اَلْكُرَةُ وَالنَّجْمَةُ"
 },
 {
  "key": "19f9f683",
  "text": "اَلْمُكَعَّبُ وَالنَّجْمَةُ"
 },
 {
  "key": "0c75727f",
  "text": "كَمِ الْفَرْقُ بَيْنَ الْفَنَاجِينِ وَالدِّلَالِ؟"
 },
 {
  "key": "b4a06912",
  "text": "كَمْ كُرَةً فِي التَّمْثِيلِ كُلِّهِ؟"
 },
 {
  "key": "f9983ac4",
  "text": "أَضَفْنَا تُفَّاحَتَيْنِ. كَمْ يُصْبِحُ التُّفَّاحُ؟"
 }
]